#include <stdio.h>

int main() {
    int num;

    printf("Enter an integer number: ");
    scanf("%d", &num);

    printf("\n Number Properties \n");

    // 1. Positive, Negative, or Zero Check
    if (num > 0) {
        printf("Positive/Negative: Positive\n");
    } else if (num < 0) {
        printf("Positive/Negative: Negative\n");
    } else {
        printf("Positive/Negative: Zero (Neither Positive nor Negative)\n");
    }

    // 2. Even or Odd Check
    if (num % 2 == 0) {
        printf("Even/Odd: Even\n");
    } else {
        printf("Even/Odd: Odd\n");
    }

    // 3. Divisibility by 3
    if (num % 3 == 0) {
        printf("Divisibility: Divisible by 3\n");
    } else {
        printf("Divisibility: NOT divisible by 3\n");
    }

    // 4. Divisibility by 5
    if (num % 5 == 0) {
        printf("Divisibility: Divisible by 5\n");
    } else {
        printf("Divisibility: NOT divisible by 5\n");
    }

    // 5. Multiple of BOTH 3 and 5 Check
    if (num % 3 == 0 && num % 5 == 0) {
        printf("Multiple: Multiple of BOTH 3 and 5 (Divisible by 15)\n");
    } else {
        printf("Multiple: NOT a multiple of both 3 and 5\n");
    }

    return 0;
}
